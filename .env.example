# Environment Variables Configuration
# Copy this file to '.env' and add your API key.
# IMPORTANT: Never commit your actual '.env' file or share your API keys publicly!

# Port for the local backend server (default: 3000)
PORT=3000

# OPTION 1: Google Gemini API (RECOMMENDED - Has a 100% Free Tier!)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTION 2: OpenAI API (Alternative - Requires paid credits / billing setup)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
